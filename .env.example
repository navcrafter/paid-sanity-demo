# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SANITY_PROJECT_ID=w3zehfjc
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# Sanity API token with the Viewer role (sanity.io/manage → API → Tokens).
SANITY_API_READ_TOKEN=

# Random string; must match the secret on the Sanity webhook.
SANITY_REVALIDATE_SECRET=
