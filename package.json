{
  "name": "paid-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "node --env-file=.env.local node_modules/sanity/bin/sanity schemas extract --path=src/sanity/extract.json --enforce-required-fields --force && node --env-file=.env.local node_modules/sanity/bin/sanity typegen generate",
    "seed:singletons": "node --env-file=.env.local node_modules/sanity/bin/sanity exec scripts/create-singletons.ts --with-user-token",
    "seed:settings": "node --env-file=.env.local node_modules/sanity/bin/sanity exec scripts/seed-site-settings.ts --with-user-token",
    "seed:pages": "node --env-file=.env.local node_modules/sanity/bin/sanity exec scripts/seed-pages.ts --with-user-token --",
    "seed:q4": "node --env-file=.env.local node_modules/sanity/bin/sanity exec scripts/seed-q4-events.ts --with-user-token",
    "migrate:testimonials": "node --env-file=.env.local node_modules/sanity/bin/sanity exec scripts/migrate-testimonials.ts --with-user-token",
    "seed:starters": "node --env-file=.env.local node_modules/sanity/bin/sanity exec scripts/seed-event-starters.ts --with-user-token"
  },
  "dependencies": {
    "@sanity/assist": "^6.2.6",
    "@sanity/client": "^8.15.0",
    "@sanity/icons": "^5.3.0",
    "@sanity/image-url": "^2.1.1",
    "next": "16.4.5",
    "next-sanity": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.22.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "typescript": "^5"
  }
}
