          "_type": "eventFaq",
          "_key": "9e47fc0f1ee5",
          "question": "Can I bring a guest?",
          "answer": "Due to the exclusive nature of this event, attendance is by invitation only and non-transferable."
        },
        {
          "_type": "eventFaq",
          "_key": "9d644e13e9ab",
          "question": "What if I have dietary restrictions?",
          "answer": "We’ve got you covered! Please let us know your dietary needs during registration, and we’ll ensure accommodations are made."
        },
        {
          "_type": "eventFaq",
          "_key": "8ccc0387af60",
          "question": "Will there be parking or transportation provided?",
          "answer": "Details regarding parking or transportation will be included in your confirmation email."
